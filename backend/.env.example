# Server Configuration
PORT=3000

# Database (for Railway, use the volume path)
# DATABASE_PATH=/data/agenciapro.db

# Email Configuration (for invoice notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Anthropic API (for PDF analysis with Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app.vercel.app

# WhatsApp vía Kapso (https://app.kapso.ai) — proyecto "Agente LA REAL | Orbit"
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=1372813385917210
KAPSO_WEBHOOK_SECRET=
KAPSO_ORGANIZATION_ID=1
WHATSAPP_DEFAULT_COUNTRY_CODE=57
# Plantilla aprobada para cobros fuera de la ventana de 24 h (ver kapso whatsapp templates list)
KAPSO_TEMPLATE_COBRO=estado_de_cuenta
